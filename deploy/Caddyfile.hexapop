# Bloc à ajouter au Caddyfile du proxy public (LXC 109).
hexapop.app, www.hexapop.app {
	import cloudflare_dns
	import journal
	@www host www.hexapop.app
	redir @www https://hexapop.app{uri} permanent
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	reverse_proxy 192.168.1.103:8787
}
