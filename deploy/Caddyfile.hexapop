
# Exemple de bloc Caddy pour exposer Hexa (derrière Cloudflare, certificats par DNS).
# Les snippets cloudflare_dns, journal, sondes et anti_exploits sont à définir dans votre Caddyfile.
hexapop.app, www.hexapop.app {
	import cloudflare_dns
	import journal
	import sondes
	import anti_exploits
	@www host www.hexapop.app
	redir @www https://hexapop.app{uri} permanent
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	reverse_proxy {$HEXAPOP_UPSTREAM:127.0.0.1:8787}
}
