# Copier en .env sur infra (chmod 600). Les valeurs SMTP viennent de ~/.hexa_smtp.
DAILY_SECRET=change-moi
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=noreply@hexapop.app
SMTP_PASS=
SMTP_FROM=noreply@hexapop.app
# Connexions externes (facultatives : chaque bouton n'apparaît que si son fournisseur est configuré)
# Adresse de retour à déclarer chez chaque fournisseur : https://<domaine>/api/auth/oauth/<google|discord|twitch|apple>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
